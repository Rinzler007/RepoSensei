# Provider: "ollama" (default) or "gemini"
LLM_PROVIDER=ollama

# Output mode: "strict" (default) or "helpful"
# strict: never invent routes/features; only state what’s evidenced
# helpful: can add "likely" suggestions, clearly labeled
RESPONSE_MODE=strict

# Ollama settings
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# Gemini (Google) settings (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash